{
  "inputs": {
    "spawn_agent": {
      "properties": {
        "name": {
          "description": "A unique canonical name for the agent within this conversation. Use one to three lowercase words separated by hyphens, such as 'reviewer' or 'code-reviewer'.",
          "maxLength": 48,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+){0,2}$",
          "title": "Name",
          "type": "string"
        },
        "task": {
          "description": "A complete, self-contained task for the agent. Include the relevant context, constraints, desired outcome, and expected response format.",
          "minLength": 1,
          "title": "Task",
          "type": "string"
        },
        "cwd": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional directory for the agent. Defaults to the current workspace directory. Relative paths are resolved against the current workspace. context_mode='fork' requires cwd to match the current working directory.",
          "title": "Cwd"
        },
        "context_mode": {
          "default": "fork",
          "description": "How to initialize the agent's conversation. 'fork' copies the current conversation into an isolated child; 'fresh' starts without parent conversation context. Defaults to 'fork'.",
          "enum": [
            "fork",
            "fresh"
          ],
          "title": "Context Mode",
          "type": "string"
        }
      },
      "required": [
        "name",
        "task"
      ],
      "title": "SpawnAgentInput",
      "type": "object"
    },
    "wait_agent": {
      "properties": {
        "agent_id": {
          "description": "The agent ID returned by spawn_agent or followup_agent.",
          "minLength": 1,
          "title": "Agent Id",
          "type": "string"
        },
        "timeout_ms": {
          "default": 30000,
          "description": "Maximum time to wait in milliseconds. Use 0 to return the current status immediately. Defaults to 30000 and is capped at 300000.",
          "maximum": 300000,
          "minimum": 0,
          "title": "Timeout Ms",
          "type": "integer"
        }
      },
      "required": [
        "agent_id"
      ],
      "title": "WaitAgentInput",
      "type": "object"
    },
    "list_agents": {
      "properties": {},
      "title": "ListAgentsInput",
      "type": "object"
    },
    "followup_agent": {
      "properties": {
        "agent_id": {
          "description": "The ID of an idle, failed, interrupted, or canceled agent to resume.",
          "minLength": 1,
          "title": "Agent Id",
          "type": "string"
        },
        "task": {
          "description": "The new task to run in the agent's existing conversation.",
          "minLength": 1,
          "title": "Task",
          "type": "string"
        }
      },
      "required": [
        "agent_id",
        "task"
      ],
      "title": "FollowupAgentInput",
      "type": "object"
    },
    "steer_agent": {
      "properties": {
        "agent_id": {
          "description": "The ID of the currently running agent to guide.",
          "minLength": 1,
          "title": "Agent Id",
          "type": "string"
        },
        "message": {
          "description": "The instruction to inject before the child agent's next model request.",
          "maxLength": 10000,
          "minLength": 1,
          "title": "Message",
          "type": "string"
        }
      },
      "required": [
        "agent_id",
        "message"
      ],
      "title": "SteerAgentInput",
      "type": "object"
    },
    "cancel_agent": {
      "properties": {
        "agent_id": {
          "description": "The agent ID returned by spawn_agent or followup_agent.",
          "minLength": 1,
          "title": "Agent Id",
          "type": "string"
        }
      },
      "required": [
        "agent_id"
      ],
      "title": "CancelAgentInput",
      "type": "object"
    }
  },
  "agentOutput": {
    "description": "An agent and its current run, with results included by wait_agent.",
    "properties": {
      "agent_id": {
        "title": "Agent Id",
        "type": "string"
      },
      "name": {
        "title": "Name",
        "type": "string"
      },
      "run_id": {
        "title": "Run Id",
        "type": "string"
      },
      "generation": {
        "title": "Generation",
        "type": "integer"
      },
      "conversation_id": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "title": "Conversation Id"
      },
      "status": {
        "enum": [
          "starting",
          "running",
          "completed",
          "failed",
          "interrupted",
          "canceled"
        ],
        "title": "Status",
        "type": "string"
      },
      "agent_status": {
        "enum": [
          "starting",
          "running",
          "canceling",
          "idle",
          "failed",
          "interrupted",
          "canceled"
        ],
        "title": "Agent Status",
        "type": "string"
      },
      "task": {
        "title": "Task",
        "type": "string"
      },
      "cwd": {
        "title": "Cwd",
        "type": "string"
      },
      "context_mode": {
        "enum": [
          "fork",
          "fresh"
        ],
        "title": "Context Mode",
        "type": "string"
      },
      "created_at": {
        "title": "Created At",
        "type": "string"
      },
      "started_at": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "title": "Started At"
      },
      "completed_at": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "title": "Completed At"
      },
      "updated_at": {
        "title": "Updated At",
        "type": "string"
      },
      "error": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Error"
      },
      "result": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Result"
      },
      "partial_result": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Partial Result"
      }
    },
    "required": [
      "agent_id",
      "name",
      "run_id",
      "generation",
      "conversation_id",
      "status",
      "agent_status",
      "task",
      "cwd",
      "context_mode",
      "created_at",
      "started_at",
      "completed_at",
      "updated_at"
    ],
    "title": "AgentOutput",
    "type": "object"
  },
  "steerAgentOutput": {
    "properties": {
      "agent_id": {
        "title": "Agent Id",
        "type": "string"
      },
      "name": {
        "title": "Name",
        "type": "string"
      },
      "message": {
        "title": "Message",
        "type": "string"
      },
      "accepted": {
        "title": "Accepted",
        "type": "boolean"
      },
      "alreadyPending": {
        "title": "Alreadypending",
        "type": "boolean"
      }
    },
    "required": [
      "agent_id",
      "name",
      "message",
      "accepted",
      "alreadyPending"
    ],
    "title": "SteerAgentOutput",
    "type": "object"
  }
}
